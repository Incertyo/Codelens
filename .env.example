# Optional AI notes, analysis suggestions and per-run C++/Java simulation.
# Real execution, AST inspection and empirical measurements work without a key.
# Off by default. Enable only after completing README's Production AI controls checklist.
AI_ENABLED=false
# Provider calls per UTC day/environment, INCLUDING validation retries. Positive integer.
AI_DAILY_LIMIT=100
# Providers: openai, openai-compatible, anthropic, google
# Gemini: set google, an AI Studio key, your available LLM_MODEL, and AI_ENABLED=true.
# Set AI_DAILY_LIMIT BELOW that model/project's free daily quota (leave retry headroom).
# Free-tier source may be used by Google to improve products; see README before opting in.
LLM_PROVIDER=openai
LLM_API_KEY=
# Set a model supported by your provider; no model is silently selected.
LLM_MODEL=
# Optional, for a trusted OpenAI-compatible endpoint. Never set this from client input.
LLM_BASE_URL=
# Shared AI limiter. Valid POSTs fail closed if this store is missing/unavailable.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Stable app name; VERCEL_ENV is appended (5 client requests/minute, 10 provider calls/minute).
# Prefer separate Redis databases for preview and production.
CODELENS_RATE_NAMESPACE=codelens
# Vercel supplies production/preview/development. Unset locally means development.
# Never use deployment IDs or URLs in the rate-limit namespace.
# Vercel automatically uses the verified static catalog. Set to 1 to smoke-test it locally.
CODELENS_STATIC_LIBRARY=1
