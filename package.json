{
  "name": "codelens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "library:seed": "tsx scripts/seed-library.ts",
    "library:export": "node scripts/prepare-library.mjs",
    "predev": "node scripts/generate-worker-core.mjs && npm run library:seed",
    "prebuild": "node scripts/generate-worker-core.mjs && node scripts/verify-library.mjs",
    "pretest": "npm run library:seed",
    "pretest:e2e": "npm run build",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check:env": "node scripts/check-env.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "test:golden:quick": "node scripts/test-golden-quick.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "postinstall": "node scripts/copy-runtime.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.79",
    "@ai-sdk/google": "^4.0.94",
    "@ai-sdk/openai": "^4.0.92",
    "@fontsource/doto": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "@fontsource/space-grotesk": "^5.2.0",
    "@monaco-editor/react": "^4.7.0",
    "@vscode/vscode-languagedetection": "^1.0.23",
    "acorn": "^8.19.0",
    "ai": "^7.0.138",
    "astring": "^1.9.0",
    "framer-motion": "^12.0.0",
    "gsap": "^3.13.0",
    "lucide-react": "^0.468.0",
    "lz-string": "^1.5.0",
    "monaco-editor": "^0.57.0",
    "next": "^16.0.0",
    "pyodide": "^0.28.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "lighthouse": "^13.0.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  }
}
